<Page x:Class="Todo.Main1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Todo"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Main1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="171*"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="Photo" HorizontalAlignment="Left" Height="70" Margin="10,10,0,0" VerticalAlignment="Top" Width="80"  Source="/Снимок экрана 2025-09-19 204533.png">
            <Image.ContextMenu>
                <ContextMenu x:Name="Menu">
                    <MenuItem Header="Выход" Click="Выход_Click"  />
                    <MenuItem Header="Изменить фото профиля" Click="СменаФото_Click" />
                </ContextMenu>
            </Image.ContextMenu>
        </Image>
        <Button Content="Дом" HorizontalAlignment="Left" Margin="20,52,0,0" VerticalAlignment="Top" BorderBrush="White" Background="{x:Null}" Foreground="#FF6DE511" FontSize="18" Click="DomButton_Click" Grid.Column="1"/>
        <Button Content="Работа" HorizontalAlignment="Left" Margin="84,52,0,0" VerticalAlignment="Top" BorderBrush="White" Background="{x:Null}" Foreground="#FFE54B4B" FontSize="18" Click="RabotaButton_Click" Grid.Column="1"/>
        <Button Content="Учеба" HorizontalAlignment="Left" Margin="169,52,0,0" VerticalAlignment="Top" BorderBrush="White" Background="{x:Null}" Foreground="#FF4E54BC" FontSize="18"  Click="UchebaButton_Click" Grid.Column="1"/>
        <Button Content="Отдых" HorizontalAlignment="Left" Margin="243,52,0,0" VerticalAlignment="Top" BorderBrush="White" Background="{x:Null}" Foreground="#FF9D37AD" FontSize="18" Click="OtdihButton_Click" Grid.Column="1"/>
        <Button Content="Задачи" HorizontalAlignment="Left" Margin="18,166,0,0" VerticalAlignment="Top" BorderBrush="White" Background="{x:Null}" Foreground="#FF5C195D" FontSize="18"/>
        <Button Content="История" HorizontalAlignment="Left" Margin="18,212,0,0" VerticalAlignment="Top" BorderBrush="White" Background="{x:Null}" Foreground="#FF5C195D" FontSize="18" Click="Button_Click_1"/>
        <Button Content="+" HorizontalAlignment="Left" Margin="26,497,0,0" VerticalAlignment="Top" Background="#FFDD5336" FontSize="20" Click="Button_Click" Foreground="White" Height="54" Width="55" BorderBrush="White">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="27 27 27 27"/>
                </Style>
            </Button.Resources>
        </Button>
        <ListBox x:Name="TasksListBox" Margin="20,105,329,33" SelectionChanged="TasksListBox_SelectionChanged" Grid.Column="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <CheckBox Content="{Binding Title}" 
                  IsChecked="{Binding IsCompleted}" 
                  Checked="TaskCheckBox_Checked"
                  Margin="5" FontSize="14"/>
                        <TextBlock Text="{Binding DisplayTime}" 
                      Margin="25,1,0,0" 
                      FontSize="11" 
                      Foreground="#666666"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border BorderBrush="Black" BorderThickness="1" Margin="385,0,28,110" Height="369" VerticalAlignment="Bottom" Grid.Column="1">
            <StackPanel Height="368" VerticalAlignment="Center">
                <Label Content="Заголовок" HorizontalAlignment="Center" FontSize="24"/>
                <StackPanel Orientation="Horizontal" Height="26" Width="230">
                    <TextBlock x:Name="DetailTime"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="39" Width="230">
                    <TextBlock x:Name="DetailDate"/>
                </StackPanel>
                <Border>

                </Border>
                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Height="151" Width="230"/>
                <Button x:Name="CompleteButton" Content="Готово" Click="CompleteButton_Click" Height="40" Margin="0,0,0,5" Width="224" BorderBrush="#FFEA5656" Background="#FFEA5656" Foreground="White" FontSize="17" CommandParameter="{Binding}" >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15 15 5 5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click" Height="40" Margin="0,5,0,0" Width="224" Background="#FFEA5656" BorderBrush="#FFEA5656" Foreground="White" FontSize="17">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5 5 15 15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
        <Label Content="{Binding UserName}" HorizontalAlignment="Left" Margin="10,85,0,0" VerticalAlignment="Top" FontSize="16" Width="106" Height="31"/>

    </Grid>
</Page>
