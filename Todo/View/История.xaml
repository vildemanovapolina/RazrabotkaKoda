<Page x:Class="Todo.История1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Todo"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="История1">

    <Grid>
        <Image x:Name="Photo" HorizontalAlignment="Left" Height="70" Margin="10,10,0,0" VerticalAlignment="Top" Width="80"  Source="/Снимок экрана 2025-09-19 204533.png">
            <Image.ContextMenu>
                <ContextMenu x:Name="Menu">
                    <MenuItem Header="Выход" Click="Выход_Click"  />
                    <MenuItem Header="Изменить фото профиля" Click="СменаФото_Click" />
                </ContextMenu>
            </Image.ContextMenu>
        </Image>
        <Button Content="Дом" HorizontalAlignment="Left" Margin="136,52,0,0" VerticalAlignment="Top" BorderBrush="White"  FontSize="18" Click="DomButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#FF6DE511"/>
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="Работа" HorizontalAlignment="Left" Margin="200,52,0,0" VerticalAlignment="Top" BorderBrush="White"  FontSize="18" Click="RabotaButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#FFE54B4B"/>
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="Учеба" HorizontalAlignment="Left" Margin="285,52,0,0" VerticalAlignment="Top" BorderBrush="White"  FontSize="18"  Click="UchebaButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#FF4E54BC"/>
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="Отдых" HorizontalAlignment="Left" Margin="359,52,0,0" VerticalAlignment="Top" BorderBrush="White" FontSize="18" Click="OtdihButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#FF9D37AD"/>
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="Задачи" HorizontalAlignment="Left" Margin="18,166,0,0" VerticalAlignment="Top" BorderBrush="White"  FontSize="18" Click="Button_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#FF5C195D"/>
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="История" HorizontalAlignment="Left" Margin="18,212,0,0" VerticalAlignment="Top" BorderBrush="White"  FontSize="18">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#FF5C195D"/>
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Content="+" HorizontalAlignment="Left" Margin="26,497,0,0" VerticalAlignment="Top" Background="#FFDD5336" FontSize="20" Click="Button_Click" Foreground="White" Height="54" Width="55" BorderBrush="White">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="27 27 27 27"/>
                </Style>
            </Button.Resources>
        </Button>
        <ListBox x:Name="History" Margin="136,105,329,33" SelectionChanged="History_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <CheckBox Content="{Binding Title}" 
            IsChecked="True"
            IsEnabled="False"
            Margin="5" FontSize="14"/>
                        <TextBlock Text="{Binding DisplayTime}" 
                Margin="25,1,0,0" 
                FontSize="11" 
                Foreground="#666666"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border BorderBrush="Black" BorderThickness="1" Margin="501,0,28,159" Height="320" VerticalAlignment="Bottom">
            <StackPanel Height="320" VerticalAlignment="Center">
                <TextBlock x:Name="Name" HorizontalAlignment="Center" 
                VerticalAlignment="Top"
                FontSize="24" 
                FontWeight="Bold"
                Margin="0,5,0,5"
                Width="230"
                Height="35"
                TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Height="26" Width="230">
                    <TextBlock x:Name="DetailTime"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="39" Width="230">
                    <TextBlock x:Name="DetailDate"/>
                </StackPanel>
                <Border>

                </Border>
                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Height="151" Width="230"/>
            </StackPanel>
        </Border>
        <Label Content="{Binding UserName}" HorizontalAlignment="Left" Margin="10,85,0,0" VerticalAlignment="Top" FontSize="16" Width="106" Height="31"/>

    </Grid>
</Page>
