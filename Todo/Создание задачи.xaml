<Window x:Class="Todo.Создание_задачи"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todo"
        mc:Ignorable="d"
        Title="Создание_задачи" Height="600" Width="800">
    <Grid Background="#FFE9E3E3">
        <Label Content="Название" HorizontalAlignment="Left" Margin="36,36,0,0" VerticalAlignment="Top" FontSize="20"/>
        <TextBox x:Name="Название" HorizontalAlignment="Left" Margin="36,78,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="351" BorderBrush="#FFE9E3E3" Height="57">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10 10 10 10"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Label Content="Категория" HorizontalAlignment="Left" Margin="36,164,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Описание" HorizontalAlignment="Left" Margin="36,267,0,0" VerticalAlignment="Top" FontSize="20"/>
        <TextBox x:Name="Описание" HorizontalAlignment="Left" Margin="36,309,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="351" BorderBrush="#FFE9E3E3" Height="123">
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10 10 10 10"/>
                </Style>
            </TextBox.Resources>
        </TextBox>
        <Button Content="Создать" HorizontalAlignment="Left" Margin="36,520,0,0" VerticalAlignment="Top" Background="#FF5DAA44" FontSize="15" Click="Button_Click" Foreground="White" Height="36" Width="351" BorderBrush="White">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="7 7 7 7"/>
                </Style>
            </Button.Resources>
        </Button>
        <DatePicker x:Name="Дата" HorizontalAlignment="Left"   VerticalAlignment="Top" Height="185" Width="239" Margin="494,78,0,0" SelectedDate="{x:Static System:DateTime.Today}"/>
        <Button Content="Отмена" HorizontalAlignment="Left" Margin="421,520,0,0" VerticalAlignment="Top" Background="#FFEA5656" FontSize="15" Click="Button_Click_1" Foreground="White" Height="36" Width="351" BorderBrush="White">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="7 7 7 7"/>
                </Style>
            </Button.Resources>
        </Button>
        <ComboBox x:Name="Категория" HorizontalAlignment="Left" Margin="36,206,0,0" VerticalAlignment="Top" Width="351" BorderBrush="White" Height="37" Text="" Background="White">
            <ComboBoxItem Content="Дом"/>
            <ComboBoxItem Content="Работа"/>
            <ComboBoxItem Content="Учеба"/>
            <ComboBoxItem Content="Отдых"/>
        </ComboBox>
        <Label Content="Время" HorizontalAlignment="Left" Margin="494,292,0,0" VerticalAlignment="Top" FontSize="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="496,334,0,0" VerticalAlignment="Top">
            <ComboBox x:Name="Часы" Width="60" Height="30" SelectedIndex="9">
                <ComboBoxItem>00</ComboBoxItem>
                <ComboBoxItem>01</ComboBoxItem>
                <ComboBoxItem>02</ComboBoxItem>
                <ComboBoxItem>03</ComboBoxItem>
                <ComboBoxItem>04</ComboBoxItem>
                <ComboBoxItem>05</ComboBoxItem>
                <ComboBoxItem>06</ComboBoxItem>
                <ComboBoxItem>07</ComboBoxItem>
                <ComboBoxItem>08</ComboBoxItem>
                <ComboBoxItem>09</ComboBoxItem>
                <ComboBoxItem>10</ComboBoxItem>
                <ComboBoxItem>11</ComboBoxItem>
                <ComboBoxItem>12</ComboBoxItem>
                <ComboBoxItem>13</ComboBoxItem>
                <ComboBoxItem>14</ComboBoxItem>
                <ComboBoxItem>15</ComboBoxItem>
                <ComboBoxItem>16</ComboBoxItem>
                <ComboBoxItem>17</ComboBoxItem>
                <ComboBoxItem>18</ComboBoxItem>
                <ComboBoxItem>19</ComboBoxItem>
                <ComboBoxItem>20</ComboBoxItem>
                <ComboBoxItem>21</ComboBoxItem>
                <ComboBoxItem>22</ComboBoxItem>
                <ComboBoxItem>23</ComboBoxItem>
            </ComboBox>
            <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0,5,0" FontSize="14"/>
            <ComboBox x:Name="Минуты" Width="60" Height="30" SelectedIndex="0">
                <ComboBoxItem Content="00"/>
                <ComboBoxItem Content="05"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="25"/>
                <ComboBoxItem Content="30"/>
                <ComboBoxItem Content="35"/>
                <ComboBoxItem Content="40"/>
                <ComboBoxItem Content="45"/>
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="55"/>
            </ComboBox>
        </StackPanel>


    </Grid>
</Window>
